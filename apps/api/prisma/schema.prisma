  description String?   @db.VarChar(1000)
  /// Key of a safe dataset (SQL view) from the analytics catalog.
  dataset     String    @db.VarChar(60)
  columns     String[]  @default([])
  filters     Json      @default("{}")
  groupBy     String[]  @default([]) @map("group_by")
  chartType   String    @default("table") @map("chart_type") @db.VarChar(30)
  isShared    Boolean   @default(false) @map("is_shared")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  schedules ReportSchedule[]
  runs      ReportRun[]

  @@index([companyId, deletedAt])
  @@map("report_definitions")
}

model ReportSchedule {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  definitionId String    @map("definition_id") @db.Uuid
  cron         String    @db.VarChar(80)
  format       String    @default("xlsx") @db.VarChar(10)
  recipients   String[]  @default([])
  isActive     Boolean   @default(true) @map("is_active")
  lastRunAt    DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt    DateTime? @map("next_run_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  definition ReportDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@map("report_schedules")
}

model ReportRun {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  definitionId String    @map("definition_id") @db.Uuid
  scheduleId   String?   @map("schedule_id") @db.Uuid
  status       RunStatus @default(queued)
  format       String    @default("xlsx") @db.VarChar(10)
  rowCount     Int       @default(0) @map("row_count")
  fileId       String?   @map("file_id") @db.Uuid
  error        String?   @db.VarChar(1000)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid

  definition ReportDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([companyId, definitionId])
  @@map("report_runs")
}

model AnalyticsAlert {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  kind        String    @db.VarChar(60)
  severity    Severity  @default(medium)
  title       String    @db.VarChar(300)
  detail      String?   @db.VarChar(2000)
  entityType  String?   @map("entity_type") @db.VarChar(80)
  entityId    String?   @map("entity_id") @db.Uuid
  score       Decimal?  @db.Decimal(6, 2)
  isResolved  Boolean   @default(false) @map("is_resolved")
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId, kind, isResolved])
  @@map("analytics_alerts")
}
