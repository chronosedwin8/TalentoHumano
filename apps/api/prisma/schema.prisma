// ============================================================================
//  CORE - tenancy, identity, RBAC, audit, files, notifications, workflows
// ============================================================================

model Company {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(200)
  legalName     String?   @map("legal_name") @db.VarChar(200)
  slug          String    @unique @db.VarChar(80)
  taxId         String?   @map("tax_id") @db.VarChar(40)
  logoUrl       String?   @map("logo_url") @db.VarChar(500)
  faviconUrl    String?   @map("favicon_url") @db.VarChar(500)
  primaryColor  String    @default("#2563eb") @map("primary_color") @db.VarChar(9)
  accentColor   String    @default("#0ea5e9") @map("accent_color") @db.VarChar(9)
  country       String    @default("CO") @db.VarChar(2)
  timezone      String    @default("America/Bogota") @db.VarChar(60)
  locale        String    @default("es") @db.VarChar(5)
  address       String?   @db.VarChar(240)
  city          String?   @db.VarChar(120)
  phone         String?   @db.VarChar(40)
  email         String?   @db.VarChar(160)
  website       String?   @db.VarChar(240)
  isActive      Boolean   @default(true) @map("is_active")
  settings      Json      @default("{}")
  privacyPolicy String?   @map("privacy_policy")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById   String?   @map("created_by") @db.Uuid
  updatedById   String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  companyUsers   CompanyUser[]
  locations      Location[]
  departments    Department[]
  costCenters    CostCenter[]
  positions      Position[]
  employees      Employee[]
  roles          Role[]
  companyModules CompanyModule[]

  @@index([slug])
  @@map("companies")
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String     @unique @db.VarChar(180)
  passwordHash        String?    @map("password_hash") @db.VarChar(255)
  firstName           String     @map("first_name") @db.VarChar(80)
  lastName            String     @map("last_name") @db.VarChar(80)
  avatarUrl           String?    @map("avatar_url") @db.VarChar(500)
  phone               String?    @db.VarChar(40)
  locale              String     @default("es") @db.VarChar(5)
  timezone            String     @default("America/Bogota") @db.VarChar(60)
  status              UserStatus @default(invited)
  isSuperadmin        Boolean    @default(false) @map("is_superadmin")
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  twoFactorEnabled    Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?    @map("two_factor_secret") @db.VarChar(255)
  twoFactorRecovery   String?    @map("two_factor_recovery")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  externalProvider    String?    @map("external_provider") @db.VarChar(40)
  externalId          String?    @map("external_id") @db.VarChar(180)
  lastCompanyId       String?    @map("last_company_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)

  companyUsers      CompanyUser[]
  sessions          Session[]
  employees         Employee[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  resetTokens       PasswordResetToken[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model CompanyUser {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  isDefault Boolean   @default(false) @map("is_default")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles   UserRole[]

  @@unique([companyId, userId])
  @@index([companyId, deletedAt])
  @@map("company_users")
}

model Role {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String?   @map("company_id") @db.Uuid
  key          String    @db.VarChar(60)
  name         String    @db.VarChar(120)
  description  String?   @db.VarChar(500)
  scope        Scope     @default(company)
  isSystem     Boolean   @default(false) @map("is_system")
  isAssignable Boolean   @default(true) @map("is_assignable")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid
  updatedById  String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  modules     RoleModule[]
  users       UserRole[]

  @@unique([companyId, key])
  @@index([companyId, deletedAt])
  @@map("roles")
}

model UserRole {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyUserId String   @map("company_user_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  companyUser CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([companyUserId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(120)
  module      String   @db.VarChar(40)
  resource    String   @db.VarChar(60)
  action      String   @db.VarChar(40)
  label       String   @db.VarChar(200)
  isSensitive Boolean  @default(false) @map("is_sensitive")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  scope        Scope    @default(company)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  granted      Boolean   @default(true)
  scope        Scope     @default(own)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  reason       String?   @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdById  String?   @map("created_by") @db.Uuid

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, permissionId])
  @@index([companyId, userId])
  @@map("user_permission_overrides")
}

model AppModule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(400)
  icon        String?  @db.VarChar(60)
  path        String   @db.VarChar(120)
  position    Int      @default(0)
  isCore      Boolean  @default(false) @map("is_core")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  companies CompanyModule[]
  roles     RoleModule[]
  users     UserModule[]

  @@map("modules")
}

model CompanyModule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  isEnabled Boolean  @default(true) @map("is_enabled")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module  AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@map("company_modules")
}

model RoleModule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role   Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@map("role_modules")
}

model UserModule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  moduleId  String   @map("module_id") @db.Uuid
  isVisible Boolean  @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  module AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, moduleId])
  @@map("user_modules")
}

model Delegation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  fromUserId  String    @map("from_user_id") @db.Uuid
  toUserId    String    @map("to_user_id") @db.Uuid
  permissions String[]  @default([])
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime  @map("ends_at") @db.Timestamptz(6)
  reason      String?   @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([companyId, toUserId, isActive])
  @@map("delegations")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  companyId        String?   @map("company_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.VarChar(400)
  ip               String?   @db.VarChar(60)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  impersonatedBy   String?   @map("impersonated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String?     @map("company_id") @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  actorEmail String?     @map("actor_email") @db.VarChar(180)
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(80)
  entityId   String?     @map("entity_id") @db.VarChar(80)
  summary    String?     @db.VarChar(500)
  diff       Json?
  ip         String?     @db.VarChar(60)
  userAgent  String?     @map("user_agent") @db.VarChar(400)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model SensitiveAccessLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  permission String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(80)
  reason     String?  @db.VarChar(400)
  ip         String?  @db.VarChar(60)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@map("sensitive_access_logs")
}

model CatalogItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  catalogKey  String    @map("catalog_key") @db.VarChar(60)
  code        String    @db.VarChar(60)
  label       String    @db.VarChar(200)
  description String?   @db.VarChar(500)
  color       String?   @db.VarChar(9)
  position    Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  isSystem    Boolean   @default(false) @map("is_system")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([companyId, catalogKey, code])
  @@index([companyId, catalogKey, deletedAt])
  @@map("catalog_items")
}

model CustomFieldDefinition {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  entityType   String    @map("entity_type") @db.VarChar(60)
  key          String    @db.VarChar(60)
  label        String    @db.VarChar(200)
  fieldType    String    @map("field_type") @db.VarChar(30)
  options      Json      @default("[]")
  isRequired   Boolean   @default(false) @map("is_required")
  isSensitive  Boolean   @default(false) @map("is_sensitive")
  employeeEditable Boolean @default(false) @map("employee_editable")
  helpText     String?   @map("help_text") @db.VarChar(400)
  position     Int       @default(0)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  values CustomFieldValue[]

  @@unique([companyId, entityType, key])
  @@index([companyId, entityType])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(60)
  entityId     String   @map("entity_id") @db.Uuid
  value        Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@index([companyId, entityType, entityId])
  @@map("custom_field_values")
}

model StoredFile {
