model SurveyTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  key         String   @db.VarChar(80)
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  kind        String   @default("climate") @db.VarChar(40)
  schema      Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([companyId, key])
  @@map("survey_templates")
}

model Survey {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  title         String       @db.VarChar(260)
  description   String?
  kind          String       @default("climate") @db.VarChar(40)
  status        SurveyStatus @default(draft)
  isAnonymous   Boolean      @default(true) @map("is_anonymous")
  /// Minimum responses before a segment can be displayed.
  minSegmentResponses Int    @default(5) @map("min_segment_responses")
  opensAt       DateTime?    @map("opens_at") @db.Timestamptz(6)
  closesAt      DateTime?    @map("closes_at") @db.Timestamptz(6)
  recurrence    String?      @db.VarChar(40)
  reminderDays  Int[]        @default([]) @map("reminder_days")
  currentVersionId String?   @map("current_version_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById   String?      @map("created_by") @db.Uuid
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)

  versions    SurveyVersion[]
  audiences   SurveyAudience[]
  invitations SurveyInvitation[]
  responses   SurveyResponse[]

  @@index([companyId, status, deletedAt])
  @@map("surveys")
}

model SurveyVersion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  surveyId  String   @map("survey_id") @db.Uuid
  version   Int      @default(1)
  schema    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@unique([surveyId, version])
  @@map("survey_versions")
}

model SurveyQuestion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  versionId  String   @map("version_id") @db.Uuid
  key        String   @db.VarChar(120)
  label      String   @db.VarChar(1000)
  type       String   @db.VarChar(40)
  dimension  String?  @db.VarChar(80)
  position   Int      @default(0)
  isRequired Boolean  @default(false) @map("is_required")
  config     Json     @default("{}")

  version SurveyVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@unique([versionId, key])
  @@map("survey_questions")
}

model SurveyAudience {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String  @map("company_id") @db.Uuid
  surveyId   String  @map("survey_id") @db.Uuid
  targetType String  @map("target_type") @db.VarChar(30)
  targetId   String? @map("target_id") @db.Uuid
  filters    Json    @default("{}")

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([companyId, surveyId])
  @@map("survey_audiences")
}

model SurveyInvitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  surveyId    String    @map("survey_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  token       String    @unique @db.VarChar(120)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  openedAt    DateTime? @map("opened_at") @db.Timestamptz(6)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)
  remindersSent Int     @default(0) @map("reminders_sent")
  /// Denormalised segment used for anonymity-safe aggregation.
  segment     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([surveyId, employeeId])
  @@index([companyId, surveyId])
  @@map("survey_invitations")
}

model SurveyResponse {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  surveyId     String    @map("survey_id") @db.Uuid
  versionId    String    @map("version_id") @db.Uuid
  /// Null for anonymous surveys; never written when isAnonymous is true.
  employeeId   String?   @map("employee_id") @db.Uuid
  invitationId String?   @map("invitation_id") @db.Uuid
  segment      Json      @default("{}")
  isComplete   Boolean   @default(false) @map("is_complete")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(6)

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  version SurveyVersion  @relation(fields: [versionId], references: [id])
  answers SurveyAnswer[]

  @@index([companyId, surveyId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  responseId  String   @map("response_id") @db.Uuid
  questionId  String   @map("question_id") @db.Uuid
  questionKey String   @map("question_key") @db.VarChar(120)
  value       Json?
  numericValue Decimal? @map("numeric_value") @db.Decimal(10, 2)
  textValue   String?  @map("text_value")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([companyId, questionId])
  @@map("survey_answers")
}

// ---------------------------- ethics hotline -------------------------------

model EthicsCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.VarChar(160)
  description String?  @db.VarChar(1000)
  /// Legal deadline in days (Ley 2466/2025 and internal policy).
  slaDays     Int      @default(15) @map("sla_days")
  defaultSeverity Severity @default(medium) @map("default_severity")
  position    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  reports EthicsReport[]

  @@unique([companyId, name])
  @@map("ethics_categories")
}

/// Anonymous reports never store IP or user agent. Content is encrypted.
model EthicsReport {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  trackingCode  String       @unique @map("tracking_code") @db.VarChar(40)
  accessKeyHash String       @map("access_key_hash") @db.VarChar(255)
  categoryId    String?      @map("category_id") @db.Uuid
  isAnonymous   Boolean      @default(true) @map("is_anonymous")
  /// Encrypted at rest. Only present for identified reports.
  reporterName  String?      @map("reporter_name")
  reporterEmail String?      @map("reporter_email")
  reporterPhone String?      @map("reporter_phone")
  relationship  String       @default("employee") @db.VarChar(30)
  /// Encrypted at rest.
  subject       String
  description   String
  involvedPersons String?    @map("involved_persons")
  occurredAt    DateTime?    @map("occurred_at") @db.Date
  status        EthicsStatus @default(received)
  severity      Severity     @default(medium)
  dueAt         DateTime?    @map("due_at") @db.Date
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  category EthicsCategory?      @relation(fields: [categoryId], references: [id])
  messages EthicsReportMessage[]
  ethicsCase EthicsCase?

  @@index([companyId, status])
  @@map("ethics_reports")
}

/// Two-way anonymous mailbox between reporter and investigator.
model EthicsReportMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  reportId   String   @map("report_id") @db.Uuid
  /// reporter | officer
  authorKind String   @map("author_kind") @db.VarChar(20)
  authorUserId String? @map("author_user_id") @db.Uuid
  /// Encrypted at rest.
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  report EthicsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([companyId, reportId])
  @@map("ethics_report_messages")
}

model EthicsCase {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  reportId      String       @unique @map("report_id") @db.Uuid
  caseNumber    String       @map("case_number") @db.VarChar(40)
  status        EthicsStatus @default(triaged)
  severity      Severity     @default(medium)
  leadUserId    String?      @map("lead_user_id") @db.Uuid
  /// Users excluded because they are involved in the report.
  excludedUserIds String[]   @default([]) @map("excluded_user_ids")
  /// Encrypted at rest.
  investigationPlan String?  @map("investigation_plan")
  conclusions   String?
  measures      String?
  openedAt      DateTime     @default(now()) @map("opened_at") @db.Timestamptz(6)
  dueAt         DateTime?    @map("due_at") @db.Date
  closedAt      DateTime?    @map("closed_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  report   EthicsReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  members  EthicsCaseMember[]
  actions  EthicsCaseAction[]
  evidence EthicsEvidence[]

  @@unique([companyId, caseNumber])
  @@index([companyId, status])
  @@map("ethics_cases")
}

model EthicsCaseMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("investigator") @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  case EthicsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@map("ethics_case_members")
}

model EthicsCaseAction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  caseId    String   @map("case_id") @db.Uuid
  kind      String   @db.VarChar(40)
  title     String   @db.VarChar(260)
  /// Encrypted at rest.
  detail    String?
  dueDate   DateTime? @map("due_date") @db.Date
  status    TaskStatus @default(pending)
  actorUserId String? @map("actor_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  case EthicsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([companyId, caseId])
  @@map("ethics_case_actions")
}

model EthicsEvidence {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  caseId     String   @map("case_id") @db.Uuid
  fileId     String?  @map("file_id") @db.Uuid
  title      String   @db.VarChar(260)
  /// Encrypted at rest.
  description String?
  addedByUserId String? @map("added_by_user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  case EthicsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([companyId, caseId])
  @@map("ethics_evidence")
}

/// Access log for ethics cases; separate from sensitive_access_logs so that
/// it can be kept even when other logs are purged.
model EthicsAccessLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  caseId    String?  @map("case_id") @db.Uuid
  reportId  String?  @map("report_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, caseId])
  @@map("ethics_access_logs")
}

// ------------------------ documents, policies, signing ---------------------

model DocumentTemplate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String    @db.VarChar(200)
