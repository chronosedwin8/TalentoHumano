# ============================================================================
#  TALENTO - variables de entorno
#  Copie este archivo a .env y ajuste los valores.
# ============================================================================

# --- Entorno ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_PREFIX=api
APP_NAME=TALENTO
# URL publica del frontend (usada en enlaces de correo, portales publicos, CORS)
WEB_URL=http://localhost:5173
# URL publica de la API
API_URL=http://localhost:3000
# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Base de datos ---------------------------------------------------------
DATABASE_URL=postgresql://postgres:1004@localhost:5432/talento?schema=public
# Base usada por las pruebas e2e (se recrea en cada corrida)
DATABASE_URL_TEST=postgresql://postgres:1004@localhost:5432/talento_test?schema=public

# --- Seguridad -------------------------------------------------------------
# Cambie SIEMPRE estos secretos en produccion (min. 32 caracteres)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Clave de cifrado de columnas sensibles (AES-256-GCM). 32 bytes en hex o base64.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECRET=dev-cookie-secret-change-me
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Bloqueo de cuenta
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Rate limiting global (ventana en segundos / peticiones)
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# --- Redis y colas ---------------------------------------------------------
# Si REDIS_ENABLED=false la aplicacion funciona sin colas (modo sincrono).
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# --- Almacenamiento de archivos -------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=talento
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=50

# --- Correo ----------------------------------------------------------------
# log | smtp
MAIL_DRIVER=log
MAIL_FROM="TALENTO <no-reply@talento.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- SSO (OIDC) ------------------------------------------------------------
SSO_GOOGLE_ENABLED=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_ENABLED=false
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=common

# --- Observabilidad --------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
METRICS_ENABLED=true

# --- Retencion y cumplimiento ---------------------------------------------
CANDIDATE_RETENTION_MONTHS=12
AUDIT_RETENTION_MONTHS=60

# --- Semilla demo ----------------------------------------------------------
DEMO_PASSWORD=Demo1234!
